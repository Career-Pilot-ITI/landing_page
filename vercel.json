{
  "framework": null,
  "buildCommand": null,
  "outputDirectory": ".",
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    { "source": "/login", "destination": "/login.html" },
    { "source": "/register", "destination": "/register.html" },
    { "source": "/dashboard", "destination": "/dashboard.html" },
    { "source": "/dashboard/create", "destination": "/create-interview.html" },
    { "source": "/dashboard/new", "destination": "/create-interview.html" },
    { "source": "/dashboard/interview", "destination": "/interview-detail.html" },
    { "source": "/dashboard/report", "destination": "/candidate-report.html" },
    { "source": "/dashboard/billing", "destination": "/billing.html" },
    { "source": "/dashboard/team", "destination": "/team.html" },
    { "source": "/dashboard/settings", "destination": "/settings.html" },
    { "source": "/challenge", "destination": "/challenge.html" },
    { "source": "/challenge/(.*)", "destination": "/challenge.html" },
    { "source": "/interview", "destination": "/interview.html" },
    { "source": "/interview/(.*)", "destination": "/interview.html" },
    { "source": "/employer", "destination": "/login.html" },
    { "source": "/employer/(.*)", "destination": "/login.html" },
    { "source": "/enterprise", "destination": "/login.html" },
    { "source": "/enterprise/(.*)", "destination": "/login.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    }
  ]
}
